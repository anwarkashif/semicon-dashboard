name: Generate SemicoN Weekly Brief

on:
  schedule:
    # 1. The Main Loop (Every 2 hours)
    - cron: '0 */2 * * *'
    # 2. Fallback Windows (Early Friday Morning IST)
    - cron: '30 0 * * 5'
    - cron: '0 1 * * 5'
    # 3. NEW: Weekly Tactical Generation at 6:00 PM IST (12:30 UTC)
    - cron: '30 12 * * 5'
  workflow_dispatch: 

jobs:
  build:
    runs-on: ubuntu-latest
    permissions:
      contents: write

    steps:
    - name: Checkout repository
      uses: actions/checkout@v4

    - name: Set up Python
      uses: actions/setup-python@v5
      with:
        python-version: '3.10'

    # --- FIX: ADDED beautifulsoup4 TO DEPENDENCIES ---
    - name: Install dependencies
      run: |
        python -m pip install --upgrade pip
        pip install requests google-genai plotly feedparser beautifulsoup4

    - name: Run fetch_brief.py
      env:
        GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
        NEWS_API_KEY_1: ${{ secrets.NEWS_API_KEY }}
        NEWS_API_KEY_2: ${{ secrets.NEWS_API_KEY_2 }}
        NEWS_API_KEY_3: ${{ secrets.NEWS_API_KEY_3 }}
        NEWS_API_KEY_4: ${{ secrets.NEWS_API_KEY_4 }}
      run: python fetch_brief.py

    - name: Run Executive FLASH TO BRIEF Pipeline
      env:
        GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
      run: python live_pipeline_executive.py || echo "Executive pipeline failed, skipping."

    - name: Run Weekly Tactical Pipeline (Data Gathering)
      env:
        GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
      run: python live_pipeline_weekly_tactical.py || echo "Tactical pipeline failed, skipping."

    - name: Generate Weekly Tactical Brief
      env:
        GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
      run: python generate_weekly_tactical.py || echo "Tactical generator failed, skipping."

    - name: Generate Strategic Outlook
      run: python generate_outlook.py || echo "Strategic Outlook generator not found, skipping."

    - name: Commit and Push changes
      run: |
        git config --global user.name 'github-actions[bot]'
        git config --global user.email 'github-actions[bot]@users.noreply.github.com'
        git pull origin main --rebase || echo "No changes to pull"
        git add --all data/
        git commit -m "🤖 Auto-Update: SemicoN Data updated" || echo "No changes to commit"
        git push

    # --- KOYEB AUTO-DEPLOY TRIGGER ---
    - name: Install Koyeb CLI
      uses: koyeb-community/koyeb-actions@v2
      with:
        api_token: "${{ secrets.KOYEB_API_TOKEN }}"
        github_token: "${{ secrets.GITHUB_TOKEN }}"

    - name: Trigger Koyeb Redeploy
      run: koyeb service redeploy 83c34b02-6b6a-41fb-81c5-7543947250b4
